# Copy to .env for local overrides. Defaults (in app/config.py) point at a
# local SQLite file — fine for quick `uv run uvicorn` without Docker.
# `docker compose up` overrides DATABASE_URL itself (see ../docker-compose.yml)
# and doesn't need this file.

DATABASE_URL=postgresql+psycopg://monitou:monitou@localhost:5433/monitou
JWT_SECRET_KEY=dev-secret-change-me
